sc_error_code 9 {
	request {
		code		0 : integer
		msg			1 : string
	}
}

# 异步通知checkAccount 结果
sc_check_account_result 10 {
	request {
		result 0 : integer
	}
}

sc_error_warninfo 11 {
	request {
		code		0 : integer
		msg			1 : string
	}
}

# 进入游戏
sc_enter_game 12 {
	request {
		newPlayer		0 : boolean
		dbid			1 : integer
		name 			2 : string
		head			3 : string
		coin			4 : integer
		eliminatecount 		5 : integer
		eliminatewinner		6 : integer
	}
}

sc_coin_update 13 {
	request {
		coin 0 : integer
	}
}

sc_getcoin_recharge 14 {
	request {
		coin 0 : integer
	}
}


sc_recharge_success 15 {
	request {
		id 		0 : integer
		coin 	1 : integer
	}
}

sc_actor_eliminate_count_info 16 {
	request {
		eliminatecount 		0 : integer
		eliminatewinner		1 : integer
	}
}

