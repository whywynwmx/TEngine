sc_base_game_time 6 {
	request {
		time          0 : integer
		serverRunDay  1 : integer
		yearWeek  	2: integer
	}
}

# 服务器开启数
sc_base_open_day 7 {
	request {
		day  1 : integer
		loginDay 2 : integer
		mergeDay 3 : integer
		createDay 4 : integer 
	}
}

